// The popup window (WR-02): borderless, always-on-top, fixed 360x520. It shows today's header
// and the clock lines, hides on Escape and on focus loss (WR-02 AC2). The height grew from 440 in
// the W2 review: the 44 px day cells and a 6-row month need the extra 80 px (WR-02 AC1).
import { AppInfo } from "app-info.slint";
import { Converter, ConverterData } from "converter.slint";
import { DayDetail, DayDetailData } from "day-detail.slint";
import { MonthGrid, CellData } from "month-grid.slint";
import { Theme } from "theme.slint";

export struct PopupClockLine {
    is-local: bool,
    zone-city: string,
    offset: string,
    time: string,
}

export component PopupWindow inherits Window {
    title: AppInfo.app-name;
    no-frame: true;
    always-on-top: true;
    width: 360px;
    height: 520px;
    background: Theme.surface;
    default-font-family: "Noto Sans";

    in property <string> bs: "";
    in property <string> weekday: "";
    in property <string> ad: "";
    in property <[PopupClockLine]> clocks: [];

    // Month grid state, filled by `ui_bridge::set_month` (W2-02).
    in property <[CellData]> cells: [];
    in property <[string]> weekday-headers: [];
    in property <[string]> month-names: [];
    in property <int> month-index: 0;
    in property <int> year: 1901;
    in property <string> month-title: "";
    in property <bool> can-prev: false;
    in property <bool> can-next: false;
    in property <string> holiday-name: "";
    in property <int> holiday-days: -1;
    /// 13 px for Latin, 12 px for Devanagari (WR-03 AC2), set by `ui_bridge::set_month`.
    in property <length> ad-day-size: 13px;
    /// 11 px for Latin, 12 px for Devanagari (W3-00b), set by `ui_bridge::set_month`.
    in property <length> tithi-size: 12px;

    // Day detail (W2-03): an overlay inside the popup, never a new OS window (WR-04 AC1).
    in property <DayDetailData> detail;
    in-out property <bool> detail-visible: false;

    // Converter (W3-02): another inline overlay, opened from the header.
    in-out property <bool> converter-visible: false;
    in-out property <ConverterData> converter-data;
    in-out property <string> converter-input: "";
    in-out property <string> converter-from: "";
    in-out property <string> converter-to: "";
    in-out property <int> converter-tab: 0;
    in-out property <int> converter-direction: 0;

    // Fired by the tray menu, the taskbar menu and the grid (W2-02).
    callback day-clicked(int);
    callback prev-month();
    callback next-month();
    callback today();
    callback month-picked(int);
    callback year-picked(int);
    callback wheel(int);
    // Fired by the day detail (W2-03).
    callback detail-closed();
    callback copy-detail-bs();
    callback copy-detail-ad();
    // Fired by the converter (W3-02).
    callback converter-opened();
    callback converter-closed();
    callback converter-edited(string, int);
    callback converter-days-edited(string, string);

    // Forward the window focus to the FocusScope so it receives key events and its focus-lost
    // fires when the popup is deactivated (WR-02 AC2).
    forward-focus: fs;

    // Fired whenever the popup hides: focus loss, Escape, or the Rust hide path. A click on the
    // tray icon takes the focus first, so the app needs to know the popup was open a moment ago,
    // or that click would reopen it.
    callback hidden();

    fs := FocusScope {
        focus-lost(_) => {
            root.hidden();
            root.hide();
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                // An overlay closes before the day detail, and the day detail before the popup.
                if (root.converter-visible) {
                    root.converter-visible = false;
                    root.converter-closed();
                    return accept;
                }
                // WR-04 AC3: Escape closes the detail first, then the popup.
                if (root.detail-visible) {
                    root.detail-visible = false;
                    root.detail-closed();
                    return accept;
                }
                root.hidden();
                root.hide();
                return accept;
            }
            // WR-10 AC2: the grid shortcuts work wherever the focus is inside the popup.
            if (event.text == Key.PageUp) {
                grid.prev-month();
                return accept;
            }
            if (event.text == Key.PageDown) {
                grid.next-month();
                return accept;
            }
            if (event.text == Key.Home) {
                grid.today();
                return accept;
            }
            reject
        }

        // Content stacks from the top; the month grid takes the remaining height.
        VerticalLayout {
            alignment: start;
            padding: 12px;
            spacing: 4px;

            // Two lines: the weekday and AD date share one, so a 6-row month still fits the grid
            // and the WR-03 AC8 holiday line in 520 px (WR-02 AC3 keeps every field). The
            // converter sits at the end of that line at the 11 px caption size and adds no height.
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: root.weekday + " · " + root.ad;
                    color: Theme.ink-muted;
                    font-size: 13px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                FocusScope {
                    width: 52px;
                    height: 16px;
                    accessible-role: button;
                    accessible-label: @tr("Convert");
                    accessible-action-default => {
                        root.converter-visible = true;
                        root.converter-opened();
                    }
                    Text {
                        text: @tr("Convert");
                        color: Theme.ink-muted;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            root.converter-visible = true;
                            root.converter-opened();
                        }
                    }
                }
            }
            Text { text: root.bs; color: Theme.ink; font-size: 22px; }

            Rectangle { height: 1px; background: Theme.hairline; }

            for line in root.clocks: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: line.is-local ? @tr("Local") : line.zone-city + " " + line.offset;
                    color: Theme.ink-muted;
                    font-size: 14px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Text { text: line.time; color: Theme.ink; font-size: 16px; vertical-alignment: center; }
            }

            grid := MonthGrid {
                cells: root.cells;
                weekday-headers: root.weekday-headers;
                month-names: root.month-names;
                month-index: root.month-index;
                year: root.year;
                title: root.month-title;
                can-prev: root.can-prev;
                can-next: root.can-next;
                holiday-name: root.holiday-name;
                holiday-days: root.holiday-days;
                ad-day-size: root.ad-day-size;
                tithi-size: root.tithi-size;

                day-clicked(index) => { root.day-clicked(index); }
                prev-month => { root.prev-month(); }
                next-month => { root.next-month(); }
                today => { root.today(); }
                month-picked(index) => { root.month-picked(index); }
                year-picked(year) => { root.year-picked(year); }
                wheel(delta) => { root.wheel(delta); }
            }
        }

        // Day detail overlay (WR-04): the scrim closes only the detail; the card sits above it.
        if root.detail-visible: Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            background: #40000000;
            TouchArea {
                accessible-role: button;
                accessible-label: @tr("Close day detail");
                accessible-action-default => {
                    root.detail-visible = false;
                    root.detail-closed();
                }
                clicked => {
                    root.detail-visible = false;
                    root.detail-closed();
                }
            }
            DayDetail {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: root.detail;
                copy-bs => { root.copy-detail-bs(); }
                copy-ad => { root.copy-detail-ad(); }
            }
        }

        // Converter overlay (W3-02): its scrim closes only the converter.
        if root.converter-visible: Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            background: #40000000;
            TouchArea {
                accessible-role: button;
                accessible-label: @tr("Close converter");
                accessible-action-default => {
                    root.converter-visible = false;
                    root.converter-closed();
                }
                clicked => {
                    root.converter-visible = false;
                    root.converter-closed();
                }
            }
            Converter {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: root.converter-data;
                input <=> root.converter-input;
                from <=> root.converter-from;
                to <=> root.converter-to;
                tab <=> root.converter-tab;
                direction <=> root.converter-direction;
                edited(input, direction) => { root.converter-edited(input, direction); }
                days-edited(from, to) => { root.converter-days-edited(from, to); }
                closed => {
                    root.converter-visible = false;
                    root.converter-closed();
                }
            }
        }
    }
}
