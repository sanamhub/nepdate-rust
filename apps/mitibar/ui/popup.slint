// The popup window (WR-02): borderless, always-on-top, fixed 360x520. It shows today's header
// and the clock lines, hides on Escape and on focus loss (WR-02 AC2). The 520 px height fits
// the 44 px day cells and a 6-row month (WR-02 AC1).
import { AppInfo } from "app-info.slint";
import { Converter, ConverterData } from "converter.slint";
import { DayDetail, DayDetailData } from "day-detail.slint";
import { FocusFrame } from "focus-frame.slint";
import { MonthGrid, CellData } from "month-grid.slint";
import { SettingsData, SettingsPanel } from "settings.slint";
import { Theme } from "theme.slint";

export struct PopupClockLine {
    is-local: bool,
    zone-city: string,
    offset: string,
    time: string,
}

export component PopupWindow inherits Window {
    title: AppInfo.app-name;
    no-frame: true;
    always-on-top: true;
    width: 360px;
    height: 520px;
    background: Theme.surface;
    default-font-family: "Noto Sans";

    in property <string> bs: "";
    in property <string> weekday: "";
    in property <string> ad: "";
    in property <[PopupClockLine]> clocks: [];

    // Month grid state, filled by `ui_bridge::set_month`.
    in property <[CellData]> cells: [];
    in property <[string]> weekday-headers: [];
    in property <[string]> month-names: [];
    in property <int> month-index: 0;
    in property <int> year: 1901;
    in property <string> year-text: "";
    in property <string> month-title: "";
    in property <bool> can-prev: false;
    in property <bool> can-next: false;
    in property <string> holiday-name: "";
    in property <int> holiday-days: -1;
    /// 13 px for Latin, 12 px for Devanagari (WR-03 AC2), set by `ui_bridge::set_month`.
    in property <length> ad-day-size: 13px;
    /// 11 px for Latin, 12 px for Devanagari, set by `ui_bridge::set_month`.
    in property <length> tithi-size: 12px;

    // Day detail: an overlay inside the popup, never a new OS window (WR-04 AC1).
    in property <DayDetailData> detail;
    in-out property <bool> detail-visible: false;

    // Converter: another inline overlay, opened from the header.
    in-out property <bool> converter-visible: false;
    in-out property <ConverterData> converter-data;
    in-out property <string> converter-input: "";
    in-out property <string> converter-from: "";
    in-out property <string> converter-to: "";
    in-out property <int> converter-tab: 0;
    in-out property <int> converter-direction: 0;

    // Settings: the third inline overlay, opened from the tray menu.
    in-out property <bool> settings-visible: false;
    in-out property <SettingsData> settings-data;
    in-out property <string> settings-filter: "";

    // Fired by the tray menu, the taskbar menu and the grid.
    callback day-clicked(int);
    callback prev-month();
    callback next-month();
    callback today();
    callback month-picked(int);
    callback year-picked(int);
    callback wheel(int);
    // Fired by the day detail.
    callback detail-closed();
    callback copy-detail-bs();
    callback copy-detail-ad();
    // Fired by the converter.
    callback converter-opened();
    callback converter-closed();
    callback converter-edited(string, int);
    callback converter-days-edited(string, string);
    // Fired by the settings panel.
    callback settings-closed();
    callback settings-language(int);
    callback settings-theme(int);
    callback settings-clock(bool);
    callback settings-seconds(bool);
    callback settings-zone(string);
    callback settings-launch(bool);
    callback settings-taskbar(bool);
    callback settings-filter-changed(string);

    /// False while an overlay is open, so the base controls leave the Tab cycle.
    out property <bool> base-interactive:
        !(root.detail-visible || root.converter-visible || root.settings-visible);
    /// Set by each overlay when one of its controls gains focus. Kept per overlay so a value
    /// from a closed panel cannot leak into the next one.
    in-out property <string> converter-focused: "";
    in-out property <string> settings-focused: "";
    in-out property <string> detail-focused: "";
    // A reopened panel starts with nothing focused, not the control focused when it last closed.
    changed converter-visible => { root.converter-focused = ""; }
    changed settings-visible => { root.settings-focused = ""; }
    changed detail-visible => { root.detail-focused = ""; }

    /// The focused control's stable name. Read by the interaction test; draws nothing.
    out property <string> focused-control:
        root.settings-visible ? root.settings-focused
        : root.converter-visible ? root.converter-focused
        : root.detail-visible ? root.detail-focused
        : convert-scope.has-focus ? "convert"
        : fs.has-focus ? ""
        : grid.focused-control;

    public function focus-next-year() { grid.focus-next-year(); }

    /// Called by the winit focus filter. The FocusScope below also calls it when the root holds
    /// focus, since window deactivation reaches only the focused item.
    public function window-deactivated() {
        if (root.visible) {
            root.hidden();
            root.hide();
        }
    }

    // Forward the window focus to the FocusScope so it receives key events and its focus-lost
    // fires when the popup is deactivated (WR-02 AC2).
    forward-focus: fs;

    // Fired whenever the popup hides: focus loss, Escape, or the Rust hide path. A click on the
    // tray icon takes the focus first, so the app needs to know the popup was open a moment ago,
    // or that click would reopen it.
    callback hidden();

    fs := FocusScope {
        // The root receives initial focus for Escape and focus-loss, but Tab starts at Convert.
        focus-on-tab-navigation: false;
        focus-lost(reason) => {
            // Only the window losing activation hides the popup. Tab from the root scope to a
            // child is also a focus loss.
            if (reason == FocusReason.window-activation) {
                root.window-deactivated();
            }
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                // An overlay closes before the day detail, and the day detail before the popup.
                if (root.settings-visible) {
                    root.settings-visible = false;
                    root.settings-closed();
                    convert-scope.focus();
                    return accept;
                }
                if (root.converter-visible) {
                    root.converter-visible = false;
                    root.converter-closed();
                    convert-scope.focus();
                    return accept;
                }
                // WR-04 AC3: Escape closes the detail first, then the popup.
                if (root.detail-visible) {
                    root.detail-visible = false;
                    root.detail-closed();
                    convert-scope.focus();
                    return accept;
                }
                root.hidden();
                root.hide();
                return accept;
            }
            // WR-10 AC2: the grid shortcuts work wherever the focus is inside the popup.
            if (event.text == Key.PageUp) {
                grid.prev-month();
                return accept;
            }
            if (event.text == Key.PageDown) {
                grid.next-month();
                return accept;
            }
            if (event.text == Key.Home) {
                grid.today();
                return accept;
            }
            reject
        }

        // Content stacks from the top; the month grid takes the remaining height. An open
        // overlay makes the base inert, so Tab cannot reach a control behind the scrim.
        VerticalLayout {
            alignment: start;
            padding: 12px;
            spacing: 4px;

            // Two lines: the weekday and AD date share one, so a 6-row month still fits the grid
            // and the WR-03 AC8 holiday line in 520 px (WR-02 AC3 keeps every field). The
            // converter sits at the end of that line at the 11 px caption size and adds no height.
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: root.weekday + " · " + root.ad;
                    color: Theme.ink-muted;
                    font-size: 13px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                convert-scope := FocusScope {
                    width: 52px;
                    height: 16px;
                    enabled: root.base-interactive;
                    accessible-role: button;
                    accessible-label: @tr("Convert");
                    accessible-action-default => {
                        root.converter-visible = true;
                        root.converter-opened();
                    }
                    Text {
                        text: @tr("Convert");
                        // The FocusScope above is the one accessible button; without this the
                        // Text would expose the same label a second time.
                        accessible-role: none;
                        color: Theme.ink-muted;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            root.converter-visible = true;
                            root.converter-opened();
                        }
                    }

                    FocusFrame {
                        width: 100%;
                        height: 100%;
                        focused: convert-scope.has-focus;
                        thickness: 2px;
                        radius: 3px;
                    }
                }
            }
            Text { text: root.bs; color: Theme.ink; font-size: 22px; }

            Rectangle { height: 1px; background: Theme.hairline; }

            for line in root.clocks: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: line.is-local ? @tr("Local") : line.zone-city + " " + line.offset;
                    color: Theme.ink-muted;
                    font-size: 14px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Text { text: line.time; color: Theme.ink; font-size: 16px; vertical-alignment: center; }
            }

            grid := MonthGrid {
                interactive: root.base-interactive;
                cells: root.cells;
                weekday-headers: root.weekday-headers;
                month-names: root.month-names;
                month-index: root.month-index;
                year: root.year;
                year-text: root.year-text;
                title: root.month-title;
                can-prev: root.can-prev;
                can-next: root.can-next;
                holiday-name: root.holiday-name;
                holiday-days: root.holiday-days;
                ad-day-size: root.ad-day-size;
                tithi-size: root.tithi-size;

                day-clicked(index) => { root.day-clicked(index); }
                prev-month => { root.prev-month(); }
                next-month => { root.next-month(); }
                today => { root.today(); }
                month-picked(index) => { root.month-picked(index); }
                year-picked(year) => { root.year-picked(year); }
                wheel(delta) => { root.wheel(delta); }
            }
        }

        // Day detail overlay (WR-04): the scrim closes only the detail; the card sits above it.
        if root.detail-visible: Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            background: #40000000;
            TouchArea {
                accessible-role: button;
                accessible-label: @tr("Close day detail");
                accessible-action-default => {
                    root.detail-visible = false;
                    root.detail-closed();
                    convert-scope.focus();
                }
                clicked => {
                    root.detail-visible = false;
                    root.detail-closed();
                    convert-scope.focus();
                }
            }
            DayDetail {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: root.detail;
                copy-bs => { root.copy-detail-bs(); }
                copy-ad => { root.copy-detail-ad(); }
                control-focused(name) => { root.detail-focused = name; }
            }
        }

        // Converter overlay: its scrim closes only the converter.
        if root.converter-visible: Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            background: #40000000;
            TouchArea {
                accessible-role: button;
                accessible-label: @tr("Close converter");
                accessible-action-default => {
                    root.converter-visible = false;
                    root.converter-closed();
                    convert-scope.focus();
                }
                clicked => {
                    root.converter-visible = false;
                    root.converter-closed();
                    convert-scope.focus();
                }
            }
            Converter {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: root.converter-data;
                input <=> root.converter-input;
                from <=> root.converter-from;
                to <=> root.converter-to;
                tab <=> root.converter-tab;
                direction <=> root.converter-direction;
                edited(input, direction) => { root.converter-edited(input, direction); }
                days-edited(from, to) => { root.converter-days-edited(from, to); }
                control-focused(name) => { root.converter-focused = name; }
                closed => {
                    root.converter-visible = false;
                    root.converter-closed();
                    convert-scope.focus();
                }
            }
        }

        // Settings overlay: its scrim closes only the settings panel.
        if root.settings-visible: Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            background: #40000000;
            TouchArea {
                accessible-role: button;
                accessible-label: @tr("Close settings");
                accessible-action-default => {
                    root.settings-visible = false;
                    root.settings-closed();
                    convert-scope.focus();
                }
                clicked => {
                    root.settings-visible = false;
                    root.settings-closed();
                    convert-scope.focus();
                }
            }
            SettingsPanel {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: root.settings-data;
                zone-filter <=> root.settings-filter;
                language-picked(index) => { root.settings-language(index); }
                theme-picked(index) => { root.settings-theme(index); }
                clock-changed(value) => { root.settings-clock(value); }
                seconds-changed(value) => { root.settings-seconds(value); }
                zone-picked(zone) => { root.settings-zone(zone); }
                launch-changed(value) => { root.settings-launch(value); }
                taskbar-changed(value) => { root.settings-taskbar(value); }
                filter-zones(text) => { root.settings-filter-changed(text); }
                control-focused(name) => { root.settings-focused = name; }
                closed => {
                    root.settings-visible = false;
                    root.settings-closed();
                    convert-scope.focus();
                }
            }
        }
    }
}
