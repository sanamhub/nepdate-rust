// The month grid (WR-03): title, prev/next/today, month and year pickers, a Sunday-first
// 7-column grid, and the next-holiday line. Presentation only: `app::MonthView` decides the
// cells, `ui_bridge.rs` converts them, and this file never calls `nepdate`.

import { FocusFrame } from "focus-frame.slint";
import { Theme } from "theme.slint";
import { Button, ComboBox, Palette } from "std-widgets.slint";

/// One cell as the grid draws it. `date` stays in Rust; the label is data built from ISO dates,
/// the weekday name and the tithi name, with no English sentence.
export struct CellData {
    bs-day: string,
    ad-day: string,
    ad-month: string,
    is-today: bool,
    is-holiday: bool,
    is-saturday: bool,
    tithi: string,
    has-events: bool,
    is-padding: bool,
    accessible-label: string,
}

component DayCell inherits Rectangle {
    in property <CellData> data;
    in property <int> index;
    in property <bool> interactive: true;
    /// The AD day's size: 13 px for Latin, 12 px for Devanagari (widget-design §3/§4).
    in property <length> ad-day-size: 13px;
    /// The tithi's size: the 11 px Latin caption step, 12 px for Devanagari (W3-00b).
    in property <length> tithi-size: 12px;
    callback clicked(int);
    callback focused(string);

    horizontal-stretch: 1;
    // Two lines on the 4 px grid: 4 px padding, a 20 px numeral line and a 16 px tithi line,
    // 44 px in total. The grid gap is 2 px (see the GridLayout comment), so a 6-row month fits.
    height: 44px;
    border-radius: 4px;
    border-width: data.is-today ? 2px : 0px;
    border-color: Theme.sindoor;

    fs := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.interactive && !data.is-padding;
        focus-on-tab-navigation: root.interactive && !data.is-padding;
        accessible-role: button;
        accessible-label: data.accessible-label;
        // The same action a screen reader invokes (W3-00a).
        accessible-action-default => { root.clicked(root.index); }

        // Enter or Space opens the day detail (WR-10 AC2). Tab order is the repeater order.
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked(root.index);
                return accept;
            }
            reject
        }
        changed has-focus => {
            if (fs.has-focus) {
                root.focused(data.bs-day);
            }
        }

        TouchArea {
            clicked => { root.clicked(root.index); }
        }

        // Event dot, top-left, above the numeral's ink (WR-03 AC4). One logical pixel down from
        // the ring's inner edge keeps it off the 2 px today ring.
        Rectangle {
            x: 4px;
            y: 3px;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: Theme.marigold;
            visible: data.has-events;
        }

        // Line 1: the BS day at the left (16 px) and the AD day at the right (13 px Latin,
        // 12 px Devanagari). On an AD 1st the short AD month replaces the day (WR-03 AC2).
        Text {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: 20px;
            text: data.bs-day;
            color: data.is-holiday ? Theme.sindoor : data.is-saturday ? Theme.saturday : Theme.ink;
            font-size: 16px;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
        Text {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: 20px;
            text: data.ad-month != "" ? data.ad-month : data.ad-day;
            color: Theme.ink-muted;
            font-size: data.ad-month != "" ? 11px : root.ad-day-size;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        // Line 2: the tithi, 11 px Latin or 12 px Devanagari (widget-design §3/§4), elided when
        // long. The full cell width is what lets the 11 px Latin caption fit "Saptami" at 1x
        // (W3-00b). Today keeps the 4 px inset so its 2 px ring stays clear of the glyphs.
        Text {
            x: data.is-today ? 4px : 0px;
            y: 24px;
            width: parent.width - (data.is-today ? 8px : 0px);
            height: 16px;
            text: data.tithi;
            color: Theme.ink-muted;
            font-size: root.tithi-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            visible: data.tithi != "";
        }

        // Inset so the 2 px today ring outside it stays visible when a day is focused.
        FocusFrame {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            focused: fs.has-focus;
            thickness: 2px;
            radius: 3px;
        }
    }
}

export component MonthGrid inherits Rectangle {
    /// False while an overlay covers the popup; every control leaves the Tab cycle.
    in property <bool> interactive: true;
    in property <[CellData]> cells;
    in property <[string]> weekday-headers;
    in property <[string]> month-names;
    in-out property <int> month-index: 0;
    in-out property <int> year: 1901;
    /// The year in the active language's digits (W5-04). Slint's `SpinBox` cannot format its
    /// value, so this control shows Rust's `Lang::digits(year)` string.
    in property <string> year-text: "";
    in property <string> title: "";
    in property <bool> can-prev: false;
    in property <bool> can-next: false;
    in property <string> holiday-name: "";
    in property <int> holiday-days: -1;
    /// 13 px for Latin, 12 px for Devanagari, set once from the language (WR-03 AC2).
    in property <length> ad-day-size: 13px;
    /// 11 px for Latin, 12 px for Devanagari, set once from the language (W3-00b).
    in property <length> tithi-size: 12px;

    callback day-clicked(int);
    callback prev-month();
    callback next-month();
    callback today();
    callback month-picked(int);
    callback year-picked(int);
    callback wheel(int);

    /// Used by the snapshot tool and the keyboard tests to put focus on a known control.
    public function focus-next-year() {
        year-next.focus();
    }

    /// The focused control's stable name (W7-01). Read by the interaction test; draws nothing.
    out property <string> focused-control: root.active-control;
    /// Set by the control that gains focus inside the grid.
    in-out property <string> active-control: "";

    VerticalLayout {
        spacing: 4px;

        // Title with the previous and next buttons (WR-03 AC5, AC6).
        HorizontalLayout {
            spacing: 4px;
            FocusFrame {
                width: month-prev.width;
                height: month-prev.height;
                focused: month-prev.has-focus;
                month-prev := Button {
                    text: "<";
                    accessible-label: @tr("Previous month");
                    enabled: root.interactive && root.can-prev;
                    clicked => { root.prev-month(); }
                    changed has-focus => {
                        if (month-prev.has-focus) { root.active-control = "previous month"; }
                    }
                }
            }
            Text {
                text: root.title;
                color: Theme.ink;
                font-size: 16px;
                horizontal-stretch: 1;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            FocusFrame {
                width: month-next.width;
                height: month-next.height;
                focused: month-next.has-focus;
                month-next := Button {
                    text: ">";
                    accessible-label: @tr("Next month");
                    enabled: root.interactive && root.can-next;
                    clicked => { root.next-month(); }
                    changed has-focus => {
                        if (month-next.has-focus) { root.active-control = "next month"; }
                    }
                }
            }
        }

        // Month and year pickers plus Today (WR-03 AC6, WR-10 AC2). The pickers keep their range;
        // the prev/next buttons are the controls that disable at the range edges. The pickers have
        // fixed widths so Today stays inside the 24 px margins at 360 px in both languages (W2
        // review); the spacer keeps Today at the right edge.
        HorizontalLayout {
            spacing: 4px;
            FocusFrame {
                width: month-picker.width;
                height: month-picker.height;
                focused: month-picker.has-focus;
                month-picker := ComboBox {
                    model: root.month-names;
                    current-index <=> root.month-index;
                    accessible-label: @tr("Month");
                    enabled: root.interactive;
                    width: 128px;
                    selected(_value) => { root.month-picked(root.month-index); }
                    changed has-focus => {
                        if (month-picker.has-focus) { root.active-control = "month"; }
                    }
                }
            }
            // W5-04: the standard `SpinBox` shows ASCII digits in Nepali. This control shows
            // `root.year-text` from Rust, keeps the 1901 to 2199 range, and steps by keyboard,
            // mouse wheel or the accessibility increment/decrement actions. The range edges
            // disable those actions instead of wrapping.
            // W6-03: visible 24 px buttons give pointer and touch users the same steps.
            year-scope := FocusScope {
                width: 112px;
                height: 32px;
                enabled: root.interactive;
                accessible-role: spinbox;
                accessible-label: @tr("Year");
                accessible-value: root.year-text;
                accessible-value-minimum: 1901;
                accessible-value-maximum: 2199;
                accessible-value-step: 1;
                accessible-action-set-value(v) => {
                    if (v.is-float()) {
                        root.year-picked(round(v.to-float()));
                    }
                }
                accessible-action-increment => {
                    if (root.year < 2199) { root.year-picked(root.year + 1); }
                }
                accessible-action-decrement => {
                    if (root.year > 1901) { root.year-picked(root.year - 1); }
                }
                key-pressed(event) => {
                    if (event.text == Key.UpArrow) {
                        if (root.year < 2199) { root.year-picked(root.year + 1); }
                        return accept;
                    }
                    if (event.text == Key.DownArrow) {
                        if (root.year > 1901) { root.year-picked(root.year - 1); }
                        return accept;
                    }
                    reject
                }
                focus-gained(_) => { root.active-control = "year"; }

                Rectangle {
                    border-radius: 4px;
                    background: Palette.control-background;
                    // W7: the focus ring is the design token's ink, drawn over this box below.
                    border-width: 1px;
                    border-color: Palette.border;

                    Text {
                        x: 26px;
                        width: parent.width - 52px;
                        height: 100%;
                        text: root.year-text;
                        color: Palette.control-foreground;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }

                    TouchArea {
                        clicked => { year-scope.focus(); }
                        scroll-event(event) => {
                            if (event.delta-y != 0) {
                                if (event.delta-y > 0) {
                                    if (root.year < 2199) { root.year-picked(root.year + 1); }
                                } else {
                                    if (root.year > 1901) { root.year-picked(root.year - 1); }
                                }
                                return accept;
                            }
                            reject
                        }
                    }
                }

                // 24 by 28 px inside the 112 by 32 px box: a pointer target at the 24 px
                // minimum, with the year text keeping 60 px between the two buttons.
                year-prev := FocusScope {
                    x: 2px;
                    y: 2px;
                    width: 24px;
                    height: 28px;
                    accessible-role: button;
                    accessible-label: @tr("Previous year");
                    accessible-enabled: root.interactive && root.year > 1901;
                    enabled: root.interactive && root.year > 1901;
                    focus-on-tab-navigation: true;
                    accessible-action-default => {
                        if (root.year > 1901) { root.year-picked(root.year - 1); }
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == " ") {
                            if (root.year > 1901) { root.year-picked(root.year - 1); }
                            return accept;
                        }
                        reject
                    }
                    focus-gained(_) => { root.active-control = "previous year"; }

                    Rectangle {
                        border-radius: 3px;
                        background: transparent;
                        border-width: year-prev.has-focus ? 2px : 0px;
                        border-color: Theme.ink;
                    }

                    Text {
                        text: "‹";
                        color: root.year > 1901 ? Palette.control-foreground : Palette.border;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }

                    TouchArea {
                        clicked => {
                            year-prev.focus();
                            if (root.year > 1901) { root.year-picked(root.year - 1); }
                        }
                    }
                }

                year-next := FocusScope {
                    x: 86px;
                    y: 2px;
                    width: 24px;
                    height: 28px;
                    accessible-role: button;
                    accessible-label: @tr("Next year");
                    accessible-enabled: root.interactive && root.year < 2199;
                    enabled: root.interactive && root.year < 2199;
                    focus-on-tab-navigation: true;
                    accessible-action-default => {
                        if (root.year < 2199) { root.year-picked(root.year + 1); }
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == " ") {
                            if (root.year < 2199) { root.year-picked(root.year + 1); }
                            return accept;
                        }
                        reject
                    }
                    focus-gained(_) => { root.active-control = "next year"; }

                    Rectangle {
                        border-radius: 3px;
                        background: transparent;
                        border-width: year-next.has-focus ? 2px : 0px;
                        border-color: Theme.ink;
                    }

                    Text {
                        text: "›";
                        color: root.year < 2199 ? Palette.control-foreground : Palette.border;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }

                    TouchArea {
                        clicked => {
                            year-next.focus();
                            if (root.year < 2199) { root.year-picked(root.year + 1); }
                        }
                    }
                }

                FocusFrame {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    focused: year-scope.has-focus;
                    thickness: 2px;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            FocusFrame {
                width: today-button.width;
                height: today-button.height;
                focused: today-button.has-focus;
                today-button := Button {
                    text: @tr("Today");
                    accessible-label: @tr("Today");
                    enabled: root.interactive;
                    clicked => { root.today(); }
                    changed has-focus => {
                        if (today-button.has-focus) { root.active-control = "today"; }
                    }
                }
            }
        }

        // Weekday header, Sunday first (WR-03 AC1).
        HorizontalLayout {
            for header in root.weekday-headers: Text {
                text: header;
                color: Theme.ink-muted;
                font-size: 11px;
                horizontal-stretch: 1;
                horizontal-alignment: center;
            }
        }

        // The grid. One notch scrolls one month (WR-03 AC6); the parent TouchArea receives the
        // scroll because the cells do not handle it.
        TouchArea {
            scroll-event(event) => {
                if (event.delta-y != 0) {
                    root.wheel(event.delta-y > 0 ? 1 : -1);
                    return accept;
                }
                reject
            }
            GridLayout {
                // 2 px, not 4: at 360 px, 4 px padding and a 4 px gap left the 11 px "Nov"
                // marker touching the 16 px numeral at 1x. 2 px keeps 2 px clear.
                spacing: 2px;
                for cell[i] in root.cells: DayCell {
                    data: cell;
                    index: i;
                    interactive: root.interactive;
                    ad-day-size: root.ad-day-size;
                    tithi-size: root.tithi-size;
                    row: i / 7;
                    col: mod(i, 7);
                    clicked(index) => { root.day-clicked(index); }
                    focused(day) => { root.active-control = "day " + day; }
                }
            }
        }

        // WR-03 AC8. The sentence is built here with @tr, never in Rust.
        Text {
            visible: root.holiday-days >= 0;
            color: Theme.ink-muted;
            font-size: 12px;
            horizontal-alignment: center;
            text: root.holiday-name == ""
                ? (root.holiday-days == 0
                    ? @tr("Public holiday today")
                    : root.holiday-days == 1
                        ? @tr("Public holiday tomorrow")
                        : @tr("Public holiday in {0} days", root.holiday-days))
                : (root.holiday-days == 0
                    ? @tr("Next holiday: {0} today", root.holiday-name)
                    : root.holiday-days == 1
                        ? @tr("Next holiday: {0} tomorrow", root.holiday-name)
                        : @tr("Next holiday: {0} in {1} days", root.holiday-name, root.holiday-days));
        }
    }
}
