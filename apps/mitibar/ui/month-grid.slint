// The calendar (WR-03): the title row with the previous, title, next and Today controls, and one
// of three grids: the month's days, the year's 12 months, or 12 years of a decade. Presentation
// only: `app::ZoomState` decides the level and the cursor, `app::MonthView` the cells,
// `ui_bridge.rs` converts them, and this file never calls `nepdate`.
//
// The grid is one Tab stop with a roving cursor (WR-10 AC2): the arrow keys move the cursor in
// Rust, and the cell at `cursor-index` draws the focus ring while the grid has focus.

import { FocusFrame } from "focus-frame.slint";
import { LineIcon, Pill, TooltipTiming } from "controls.slint";
import { Theme } from "theme.slint";

/// One day cell as the grid draws it. `date` stays in Rust; the label is data built from ISO dates,
/// the weekday name and the tithi name, with no English sentence.
export struct CellData {
    bs-day: string,
    ad-day: string,
    ad-month: string,
    is-today: bool,
    is-holiday: bool,
    is-saturday: bool,
    tithi: string,
    has-events: bool,
    is-padding: bool,
    accessible-label: string,
}

/// One cell of the year or decade grid. A year outside 1901 to 2199 is not enabled and has no
/// label, so it cannot be picked (WR-03 AC6).
export struct ZoomCellData {
    label: string,
    is-today: bool,
    is-viewed: bool,
    enabled: bool,
    accessible-label: string,
}

component DayCell inherits Rectangle {
    in property <CellData> data;
    in property <int> index;
    /// The roving cursor is here and the grid has focus.
    in property <bool> cursor: false;
    /// The snapshot tool shows this day's tooltip as if the pointer had rested here.
    in property <bool> force-tip: false;
    /// The AD day's size: 13 px for Latin, 12 px for Devanagari (widget-design §3/§4).
    in property <length> ad-day-size: 13px;
    /// The tithi's size: the 11 px Latin caption step, 12 px for Devanagari.
    in property <length> tithi-size: 12px;
    callback clicked(int);
    /// The pointer rested on this day: the index and the cell's window position and size.
    callback tip-requested(int, length, length, length, length);
    callback tip-dismissed();

    property <bool> tip-shown: false;
    /// The AD month stands in for the AD day on an AD 1st, except in today's cell.
    property <bool> month-marker: data.ad-month != "" && !data.is-today;
    // The content block is 28 px of numeral row and up to 26 px of tithi, and it sits in the
    // middle of the cell: a five-row month stretches the cells to about 63 px, a six-row one to
    // about 53 px (widget-design §6).
    property <length> top: max(0px, (root.height - 54px) / 2);
    // Where the numeral and the AD day stand: the disc is 28 px, so its middle is 14 px down, and
    // the digits' baseline is 20 px down (cap height 11 px centred on that middle).
    property <length> baseline: root.top + 20px;
    // The numeral's middle, and the disc's: the disc is flush with the cell's edge, which leaves
    // the AD month the room it needs after a two-digit numeral.
    property <length> numeral-centre: 14px;

    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-height: 52px;
    border-radius: 6px;
    background: touch.has-hover && !data.is-padding ? Theme.surface-raised : transparent;
    accessible-role: button;
    accessible-label: data.accessible-label;
    // The same action a screen reader invokes.
    accessible-action-default => { root.clicked(root.index); }

    touch := TouchArea {
        enabled: !data.is-padding;
        clicked => { root.clicked(root.index); }
        changed has-hover => {
            if (!touch.has-hover) {
                root.tip-shown = false;
                root.tip-dismissed();
            }
        }
    }

    // Today's numeral sits on a filled disc (WR-03 AC3). The numeral is `surface-raised` on
    // `sindoor`, which reaches 4.5:1 in both themes (checked by `theme.rs`).
    Rectangle {
        x: root.numeral-centre - 14px;
        y: root.top;
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: data.is-today ? Theme.sindoor : transparent;
    }

    // The BS day. The box is as wide as the digits, centred on `numeral-centre`, so the event dot
    // and the AD day can be placed from its edges. The two numbers share one baseline: each box
    // starts one ascent above it.
    numeral := Text {
        x: root.numeral-centre - self.preferred-width / 2;
        y: root.baseline - self.font-metrics.ascent;
        width: self.preferred-width;
        height: self.preferred-height;
        text: data.bs-day;
        color: data.is-today
            ? Theme.surface-raised
            : data.is-holiday ? Theme.sindoor : data.is-saturday ? Theme.saturday : Theme.ink;
        font-size: 16px;
        accessible-role: none;
    }

    // Event dot (WR-03 AC4): a fixed 1 px after the numeral's last digit and level with its top,
    // so it stays the same distance from the number whether the day has one digit or two. Today's
    // disc is wider than the digits, so there the dot clears the disc's edge instead.
    event-dot := Rectangle {
        x: max(numeral.x + numeral.width + 1px,
            data.is-today ? root.numeral-centre + 14px : 0px);
        y: root.baseline - 17px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: Theme.marigold;
        visible: data.has-events;
    }

    // The AD day, right-aligned 1.5 px in from the edge, on the numeral's baseline. On an AD 1st
    // the short AD month replaces the day (WR-03 AC2). It is a little tighter so "May", the widest
    // one, keeps a gap after a two-digit numeral. Today's cell keeps the day: the disc is as wide
    // as the month would need, and the header already gives today's AD date.
    ad-text := Text {
        x: parent.width - 1.5px - self.preferred-width;
        y: root.baseline - self.font-metrics.ascent;
        width: self.preferred-width;
        height: self.preferred-height;
        text: root.month-marker ? data.ad-month : data.ad-day;
        color: Theme.ink-muted;
        font-size: root.month-marker ? 11px : root.ad-day-size;
        letter-spacing: root.month-marker ? -0.5px : 0px;
        accessible-role: none;
    }

    // The tithi, one or two lines under the numeral row (widget-design §6). The text is as wide
    // as it is, centred, so a name wider than the cell shows as clipped; the layout tests
    // measure every name.
    tithi-text := Text {
        x: (parent.width - self.width) / 2;
        y: root.top + 28px;
        width: min(self.preferred-width, parent.width);
        height: self.preferred-height;
        text: data.tithi;
        color: Theme.ink-muted;
        font-size: root.tithi-size;
        line-height-factor: 0.78;
        horizontal-alignment: center;
        visible: data.tithi != "";
        accessible-role: none;
    }

    // The tooltip waits for the pointer to rest (WR-14 AC2).
    Timer {
        interval: TooltipTiming.delay;
        running: (touch.has-hover || root.force-tip) && !root.tip-shown && !data.is-padding;
        triggered => {
            root.tip-shown = true;
            root.tip-requested(root.index, root.absolute-position.x, root.absolute-position.y,
                root.width, root.height);
        }
    }

    // Inset so the ring stays inside the cell next to its neighbours.
    FocusFrame {
        width: 100%;
        height: 100%;
        focused: root.cursor && !data.is-padding;
        thickness: 2px;
        radius: 6px;
    }
}

component ZoomCell inherits Rectangle {
    in property <ZoomCellData> data;
    in property <int> index;
    in property <bool> cursor: false;
    callback clicked(int);

    horizontal-stretch: 1;
    height: 64px;
    border-radius: 6px;
    // Today's month or year takes the `sindoor` treatment; the viewed one gets a `hairline` ring
    // (widget-design §7).
    background: data.is-today
        ? Theme.sindoor
        : touch.has-hover && data.enabled ? Theme.surface-raised : transparent;
    border-width: data.is-viewed && !data.is-today ? 1px : 0px;
    border-color: Theme.hairline;
    accessible-role: button;
    accessible-label: data.accessible-label;
    accessible-action-default => { root.clicked(root.index); }

    touch := TouchArea {
        enabled: data.enabled;
        clicked => { root.clicked(root.index); }
    }

    Text {
        text: data.label;
        color: data.is-today ? Theme.surface-raised : Theme.ink;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    FocusFrame {
        width: 100%;
        height: 100%;
        focused: root.cursor && data.enabled;
        thickness: 2px;
        radius: 6px;
    }
}

export component MonthGrid inherits Rectangle {
    /// False while an overlay covers the popup; every control leaves the Tab cycle.
    in property <bool> interactive: true;
    /// 0 is the month view, 1 the year view, 2 the decade view.
    in property <int> zoom-mode: 0;
    in property <[CellData]> cells;
    in property <[ZoomCellData]> zoom-cells;
    in property <[string]> weekday-headers;
    /// The title in the active language's digits: the month and years, the year, or the decade.
    in property <string> title: "";
    /// The roving cursor's cell, or -1 when none.
    in property <int> cursor-index: -1;
    in property <bool> can-prev: false;
    in property <bool> can-next: false;
    in property <bool> today-shown: false;
    /// The snapshot tool shows this day's tooltip without a pointer; -1 in the app.
    in property <int> forced-tip-index: -1;
    /// 13 px for Latin, 12 px for Devanagari, set once from the language (WR-03 AC2).
    in property <length> ad-day-size: 13px;
    /// 11 px for Latin, 12 px for Devanagari, set once from the language.
    in property <length> tithi-size: 12px;

    callback step(int);
    callback title-clicked();
    callback today();
    callback cell-clicked(int);
    callback zoom-cell-clicked(int);
    /// 0 left, 1 right, 2 up, 3 down.
    callback arrow(int);
    callback activate();
    callback day-tip-requested(int, length, length, length, length);
    callback tip-dismissed();

    /// The focused control's stable name. Read by the interaction test; draws nothing.
    out property <string> focused-control:
        prev-button.has-focus ? "previous"
        : title-button.has-focus ? "title"
        : next-button.has-focus ? "next"
        : today-button.has-focus ? "today"
        : grid-scope.has-focus ? "grid"
        : "";

    VerticalLayout {
        spacing: 4px;

        // Previous, the title that zooms, next, and Today at the right edge (widget-design §7).
        HorizontalLayout {
            spacing: 4px;
            prev-button := Pill {
                width: 28px;
                bordered: false;
                has-icon: true;
                label: root.zoom-mode == 0 ? @tr("Previous month")
                    : root.zoom-mode == 1 ? @tr("Previous year") : @tr("Previous decade");
                enabled: root.interactive && root.can-prev;
                activated => {
                    // A control disabled while it has focus keeps its ring for good, so the
                    // grid takes the focus before the step, as for the title, and it comes back
                    // here unless the step reached the end of the range.
                    let had-focus = prev-button.has-focus;
                    if (had-focus) {
                        grid-scope.focus();
                    }
                    root.step(-1);
                    if (had-focus && root.can-prev) {
                        prev-button.focus();
                    }
                }
                LineIcon {
                    commands: "M 10 3 L 5 8 L 10 13";
                    color: prev-button.foreground;
                }
            }
            title-button := Pill {
                bordered: false;
                text: root.title;
                // 14 px, not the 16 px title step: the longest month title, the arrows and the
                // Today pill must share one 336 px row.
                font-size: 14px;
                // The name carries the visible title, so a screen reader says which month or year
                // is about to change. The decade title does nothing, so it is just the title.
                label: root.zoom-mode == 2 ? root.title : @tr("{0}, change view", root.title);
                fade-when-disabled: false;
                enabled: root.interactive && root.zoom-mode != 2;
                activated => {
                    // The decade title does nothing, so it is disabled there. A control that is
                    // disabled while it has focus keeps its focus ring for good, so the grid takes
                    // the focus first, before the view that disables the title opens.
                    if (root.zoom-mode == 1) {
                        grid-scope.focus();
                    }
                    root.title-clicked();
                }
            }
            next-button := Pill {
                width: 28px;
                bordered: false;
                has-icon: true;
                label: root.zoom-mode == 0 ? @tr("Next month")
                    : root.zoom-mode == 1 ? @tr("Next year") : @tr("Next decade");
                enabled: root.interactive && root.can-next;
                activated => {
                    // A control disabled while it has focus keeps its ring for good, so the
                    // grid takes the focus before the step, as for the title, and it comes back
                    // here unless the step reached the end of the range.
                    let had-focus = next-button.has-focus;
                    if (had-focus) {
                        grid-scope.focus();
                    }
                    root.step(1);
                    if (had-focus && root.can-next) {
                        next-button.focus();
                    }
                }
                LineIcon {
                    commands: "M 6 3 L 11 8 L 6 13";
                    color: next-button.foreground;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            today-button := Pill {
                text: @tr("Today");
                label: @tr("Today");
                visible: root.today-shown;
                enabled: root.interactive && root.today-shown;
                activated => { root.today(); }
            }
        }

        // Weekday header, Sunday first (WR-03 AC1). Only the month view has one.
        if root.zoom-mode == 0: HorizontalLayout {
            for header in root.weekday-headers: Text {
                text: header;
                color: Theme.ink-muted;
                font-size: 11px;
                horizontal-stretch: 1;
                horizontal-alignment: center;
            }
        }

        // The grid. One notch scrolls one month, year or decade (WR-03 AC6); the TouchArea behind
        // the cells receives the scroll because the cells do not handle it. The scope is the grid's
        // one Tab stop.
        grid-scope := FocusScope {
            enabled: root.interactive;
            focus-on-tab-navigation: root.interactive;
            accessible-role: none;
            // Arrow keys move the cursor and Enter or Space acts on it (WR-10 AC2); Rust owns the
            // cursor, so a month change carries it into the next month.
            key-pressed(event) => {
                if (event.text == Key.LeftArrow) { root.arrow(0); return accept; }
                if (event.text == Key.RightArrow) { root.arrow(1); return accept; }
                if (event.text == Key.UpArrow) { root.arrow(2); return accept; }
                if (event.text == Key.DownArrow) { root.arrow(3); return accept; }
                if (event.text == Key.Return || event.text == " ") {
                    root.activate();
                    return accept;
                }
                reject
            }

            TouchArea {
                scroll-event(event) => {
                    if (event.delta-y != 0) {
                        root.step(event.delta-y > 0 ? 1 : -1);
                        return accept;
                    }
                    reject
                }
            }

            VerticalLayout {
                // The month view's rows share the height the grid is given, so a five-row month
                // has no empty band above the holiday line; the year and decade cells keep their
                // own height at the top.
                alignment: root.zoom-mode == 0 ? stretch : start;

                if root.zoom-mode == 0: GridLayout {
                    // No gap between columns: the cells are 48 px wide instead of 46, which the
                    // numeral, the AD day and the longest tithi names use. Rows keep 2 px.
                    spacing-horizontal: 0px;
                    spacing-vertical: 2px;
                    for cell[i] in root.cells: DayCell {
                        data: cell;
                        index: i;
                        cursor: grid-scope.has-focus && root.cursor-index == i;
                        force-tip: root.forced-tip-index == i;
                        ad-day-size: root.ad-day-size;
                        tithi-size: root.tithi-size;
                        row: i / 7;
                        col: mod(i, 7);
                        clicked(index) => {
                            grid-scope.focus();
                            root.cell-clicked(index);
                        }
                        tip-requested(index, x, y, w, h) => { root.day-tip-requested(index, x, y, w, h); }
                        tip-dismissed => { root.tip-dismissed(); }
                    }
                }

                // The year and decade views: 4 columns by 3 rows.
                if root.zoom-mode != 0: GridLayout {
                    spacing: 8px;
                    padding-top: 8px;
                    for cell[i] in root.zoom-cells: ZoomCell {
                        data: cell;
                        index: i;
                        cursor: grid-scope.has-focus && root.cursor-index == i;
                        row: i / 4;
                        col: mod(i, 4);
                        clicked(index) => {
                            grid-scope.focus();
                            root.zoom-cell-clicked(index);
                        }
                    }
                }
            }
        }
    }
}
