// Global design tokens (docs/design/widget-design.md §2), in one file so every window and every
// later phase reads the same palette through `Theme.surface`, `Theme.ink`, and so on.
//
// The light and dark values are private; `src/theme.rs` tests that they match the design table.
// `choice` is the only input (the `theme` setting of WR-06 or the `--theme` flag). With
// `system`, the scheme comes from Slint's `Palette.color-scheme`, which the backend keeps in
// step with the OS, so a live light/dark switch repaints without any Rust code.

import { Palette } from "std-widgets.slint";

export enum ThemeChoice { system, light, dark }

export global Theme {
    in property <ThemeChoice> choice: ThemeChoice.system;

    // The standard widgets (Button, ComboBox, SpinBox) read `Palette`, not `Theme`. Keep their
    // scheme on the same side as the app's explicit choice; "system" leaves it to the OS.
    changed choice => {
        if (choice != ThemeChoice.system) {
            Palette.color-scheme = choice == ThemeChoice.dark ? ColorScheme.dark : ColorScheme.light;
        }
    }

    out property <bool> is-dark: choice == ThemeChoice.system
        ? Palette.color-scheme == ColorScheme.dark
        : choice == ThemeChoice.dark;

    // Light values (lokta paper white).
    property <color> surface-light: #FDFBF8;
    property <color> surface-raised-light: #FFFFFF;
    property <color> ink-light: #211C17;
    property <color> ink-muted-light: #6E655C;
    property <color> sindoor-light: #C12B2B;
    property <color> marigold-light: #E8A33D;
    property <color> saturday-light: #5B7C99;
    property <color> hairline-light: #E7E0D6;

    // Dark values.
    property <color> surface-dark: #16120E;
    property <color> surface-raised-dark: #201B16;
    property <color> ink-dark: #F1ECE4;
    property <color> ink-muted-dark: #9B9288;
    property <color> sindoor-dark: #E05B5B;
    property <color> marigold-dark: #E8A33D;
    property <color> saturday-dark: #7FA3C4;
    property <color> hairline-dark: #2C2620;

    // Resolved tokens. Reference these everywhere; never the `-light` / `-dark` properties.
    out property <color> surface: is-dark ? surface-dark : surface-light;
    out property <color> surface-raised: is-dark ? surface-raised-dark : surface-raised-light;
    out property <color> ink: is-dark ? ink-dark : ink-light;
    out property <color> ink-muted: is-dark ? ink-muted-dark : ink-muted-light;
    out property <color> sindoor: is-dark ? sindoor-dark : sindoor-light;
    out property <color> marigold: is-dark ? marigold-dark : marigold-light;
    out property <color> saturday: is-dark ? saturday-dark : saturday-light;
    out property <color> hairline: is-dark ? hairline-dark : hairline-light;
}
