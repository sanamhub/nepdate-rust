// The tray menu labels, in one global so the Slint tray menu and the native Windows
// taskbar menu read the same translated strings. `ui_bridge.rs` reads both.

export global MenuText {
    out property <string> open: @tr("Open");
    out property <string> copy-bs: @tr("Copy today (BS)");
    out property <string> copy-ad: @tr("Copy today (AD)");
    out property <string> settings: @tr("Settings");
    out property <string> quit: @tr("Quit");
}
