// The popup's own controls (widget-design §6, §7): the pill button and the line icons. They are
// monochrome, `ink` on `surface`, so any colour in the window means calendar data. The standard
// Slint widgets draw their own Fluent frame, so the popup's header and navigation use these.

import { FocusFrame } from "focus-frame.slint";
import { Theme } from "theme.slint";

/// A line icon drawn as a path in a 16 by 16 box. The caller sets `commands`.
export component LineIcon inherits Path {
    in property <color> color: Theme.ink;
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: root.color;
    stroke-width: 1.5px;
    fill: transparent;
}

/// How long the pointer rests before a tooltip shows (WR-14 AC2).
export global TooltipTiming {
    out property <duration> delay: 500ms;
}

/// A 28 px pill: the one button style in the popup. With `bordered: false` it is the borderless
/// icon button of the month title row. The focus ring is the W7 `ink` ring, drawn outside the
/// shape with the same radius.
export component Pill inherits Rectangle {
    in property <string> text;
    /// The accessible name, for screen readers and the interaction tests.
    in property <string> label;
    /// The tooltip: the action and its key, shown after the pointer rests (WR-10 AC2).
    in property <string> tooltip;
    /// A pinned Pin pill is filled with `ink`, its icon in `surface` (widget-design §7).
    in property <bool> filled: false;
    in property <bool> bordered: true;
    in property <bool> enabled: true;
    /// A disabled pill fades, except the title in the decade view, which is plain text there.
    in property <bool> fade-when-disabled: true;
    in property <length> pill-size: 28px;
    in property <length> font-size: 14px;
    /// The colour a child icon should use, so it follows the filled state.
    out property <color> foreground: root.filled ? Theme.surface : Theme.ink;
    out property <bool> has-focus: scope.has-focus;

    callback activated();
    /// The pill gained keyboard focus, for the Settings window's focus report and scrolling.
    callback focused();
    /// `pill.focus()` moves keyboard focus here; the popup returns to Convert when an overlay
    /// closes.
    forward-focus: scope;
    /// Fired once the pointer has rested for the tooltip delay: the text and the pill's window
    /// position and size, so the popup can place the card without covering the pill.
    callback tip-requested(string, length, length, length, length);
    callback tip-dismissed();

    height: root.pill-size;
    min-width: root.pill-size;
    preferred-width: root.text == ""
        ? root.pill-size
        : caption.preferred-width + 20px + (root.has-icon ? 20px : 0px);
    border-radius: root.pill-size / 2;
    background: root.filled
        ? Theme.ink
        : root.bordered
            ? Theme.surface-raised
            : touch.has-hover && root.enabled ? Theme.surface-raised : transparent;
    border-width: root.bordered ? 1px : 0px;
    border-color: touch.has-hover && root.enabled ? Theme.ink-muted : Theme.hairline;
    opacity: root.enabled || !root.fade-when-disabled ? 1.0 : 0.4;

    /// True when a child icon is placed before the text.
    in property <bool> has-icon: false;
    property <bool> tip-shown: false;

    scope := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        focus-on-tab-navigation: root.enabled;
        accessible-role: button;
        accessible-label: root.label;
        accessible-enabled: root.enabled;
        // Assistive technology can invoke a disabled control; it does nothing then.
        accessible-action-default => {
            if (root.enabled) {
                root.activated();
            }
        }
        focus-gained(_) => { root.focused(); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            alignment: center;
            // The icon slot and the caption are both in the layout even when empty. The 6 px gap
            // belongs only between an icon and text: next to an empty slot it pushed text 6 px past
            // the pill's preferred width, and an icon-only pill's icon 3 px left of centre.
            spacing: root.has-icon && root.text != "" ? 6px : 0px;
            // An icon has about 2 px of air inside its 16 px box, so with one the left padding is
            // 8 px and the ink sits 10 px from the edge, like the text on the other side.
            padding-left: root.text == "" ? 0px : root.has-icon ? 8px : 10px;
            padding-right: root.text == "" ? 0px : 10px;
            // The icon is centred in the pill's height; a layout would otherwise top-align it.
            VerticalLayout {
                alignment: center;
                @children
            }
            caption := Text {
                text: root.text;
                color: root.foreground;
                font-size: root.font-size;
                vertical-alignment: center;
                // An empty text still takes 4 px in a layout, which moved an icon-only pill's icon
                // 2 px left of centre.
                min-width: root.text == "" ? 0px : self.preferred-width;
                max-width: root.text == "" ? 0px : 10000px;
                accessible-role: none;
            }
        }

        touch := TouchArea {
            enabled: root.enabled;
            clicked => { root.activated(); }
            changed has-hover => {
                if (!touch.has-hover) {
                    root.tip-shown = false;
                    root.tip-dismissed();
                }
            }
        }

        // The tooltip waits for the pointer to rest (WR-14 AC2 gives the delay).
        Timer {
            interval: TooltipTiming.delay;
            running: touch.has-hover && root.enabled && !root.tip-shown && root.tooltip != "";
            triggered => {
                root.tip-shown = true;
                root.tip-requested(root.tooltip, root.absolute-position.x,
                    root.absolute-position.y, root.width, root.height);
            }
        }

        FocusFrame {
            width: 100%;
            height: 100%;
            focused: scope.has-focus;
            thickness: 2px;
            radius: root.pill-size / 2;
        }
    }
}

/// An on/off switch (widget-design §8): a 36 by 20 px pill, `ink` track with a `surface` knob when
/// on, `hairline` track with an `ink-muted` knob when off. The owner flips `checked` in answer to
/// `toggled`, so the state lives in one place.
export component Toggle inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> enabled: true;
    out property <bool> has-focus: scope.has-focus;

    /// The user asked to flip it, by click, key or assistive technology.
    callback toggled();
    callback focused();
    forward-focus: scope;

    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? Theme.ink : Theme.hairline;
    opacity: root.enabled ? 1.0 : 0.4;

    scope := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        focus-on-tab-navigation: root.enabled;
        accessible-role: switch;
        accessible-label: root.label;
        accessible-checkable: true;
        accessible-checked: root.checked;
        accessible-enabled: root.enabled;
        accessible-action-default => {
            if (root.enabled) {
                root.toggled();
            }
        }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.toggled();
                return accept;
            }
            reject
        }
        focus-gained(_) => { root.focused(); }

        Rectangle {
            x: root.checked ? parent.width - self.width - 2px : 2px;
            y: 2px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: root.checked ? Theme.surface : Theme.ink-muted;
        }
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                scope.focus();
                root.toggled();
            }
        }
        FocusFrame {
            width: 100%;
            height: 100%;
            focused: scope.has-focus;
            thickness: 2px;
            radius: 10px;
        }
    }
}

/// A segmented control for two or three values (widget-design §8): a `surface-raised` pill track,
/// the selected segment filled with `ink` and its text in `surface`. The control is one Tab stop;
/// the arrow keys move the choice, like a radio group. Each segment has an accessible name of its
/// own, so an assistive technology can pick one directly.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    /// The group's accessible name.
    in property <string> label;
    in property <length> segment-width: 84px;
    out property <bool> has-focus: scope.has-focus;

    callback picked(int);
    callback focused();
    forward-focus: scope;

    height: 28px;
    width: root.options.length * root.segment-width;
    border-radius: 14px;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.hairline;

    scope := FocusScope {
        width: 100%;
        height: 100%;
        accessible-role: tab-list;
        accessible-label: root.label;
        focus-gained(_) => { root.focused(); }
        key-pressed(event) => {
            if ((event.text == Key.LeftArrow || event.text == Key.UpArrow) && root.selected > 0) {
                root.picked(root.selected - 1);
                return accept;
            }
            if ((event.text == Key.RightArrow || event.text == Key.DownArrow)
                && root.selected < root.options.length - 1) {
                root.picked(root.selected + 1);
                return accept;
            }
            if (event.text == Key.Home && root.selected != 0) {
                root.picked(0);
                return accept;
            }
            if (event.text == Key.End && root.selected != root.options.length - 1) {
                root.picked(root.options.length - 1);
                return accept;
            }
            reject
        }

        HorizontalLayout {
            for option[i] in root.options: Rectangle {
                border-radius: 14px;
                background: i == root.selected ? Theme.ink : transparent;
                accessible-role: tab;
                accessible-label: option;
                accessible-checkable: true;
                accessible-checked: i == root.selected;
                accessible-action-default => { root.picked(i); }
                Text {
                    text: option;
                    color: i == root.selected ? Theme.surface : Theme.ink;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        scope.focus();
                        root.picked(i);
                    }
                }
            }
        }
        FocusFrame {
            width: 100%;
            height: 100%;
            focused: scope.has-focus;
            thickness: 2px;
            radius: 14px;
        }
    }
}
