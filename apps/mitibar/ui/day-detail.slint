// The day detail (WR-04): an inline card inside the popup, never a new OS window. `app::DayDetail`
// provides the text; `ui_bridge::set_detail` fills it. The scrim and the close-on-outside-click
// live in `popup.slint`.

import { FocusFrame } from "focus-frame.slint";
import { Theme } from "theme.slint";
import { Button, ScrollView } from "std-widgets.slint";

export struct DayDetailData {
    bs-long: string,
    ad-long: string,
    weekday: string,
    tithi: string,
    is-holiday: bool,
    events: [string],
    copy-bs: string,
    copy-ad: string,
}

export component DayDetail inherits Rectangle {
    in property <DayDetailData> data;
    callback copy-bs();
    callback copy-ad();
    callback control-focused(string);

    /// The focused control's stable name.
    out property <string> focused-control: root.active-control;
    /// Set by the control that gains focus inside the card.
    in-out property <string> active-control: "";
    changed active-control => { root.control-focused(root.active-control); }

    width: 280px;
    height: 320px;
    background: Theme.surface-raised;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.hairline;

    // Swallow clicks on the card so they do not reach the scrim behind it.
    TouchArea {}

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        Text { text: data.bs-long; color: Theme.ink; font-size: 16px; }
        Text { text: data.weekday; color: Theme.ink-muted; font-size: 12px; }
        Text { text: data.ad-long; color: Theme.ink-muted; font-size: 12px; }

        Rectangle { height: 1px; background: Theme.hairline; }

        // `if`, not `visible`: a hidden element still takes its slot and spacing in the layout,
        // which left a blank gap above Events on a day without a tithi or a holiday.
        if data.tithi != "": HorizontalLayout {
            spacing: 8px;
            Text { text: @tr("Tithi"); color: Theme.ink-muted; font-size: 12px; width: 48px; }
            Text { text: data.tithi; color: Theme.ink; font-size: 12px; }
        }
        if data.is-holiday: Text {
            text: @tr("Public holiday");
            color: Theme.sindoor;
            font-size: 12px;
        }

        if data.events.length > 0: Text {
            text: @tr("Events");
            color: Theme.ink-muted;
            font-size: 12px;
        }
        // A ScrollView, not a bare Flickable: a long list is cut at the box edge, and the scroll
        // bar is the only sign that more events follow.
        // The list takes the free height of the card. A fixed box made the Nepali card taller
        // than 320 px, which pushed the buttons onto the card's bottom edge.
        if data.events.length > 0: ScrollView {
            accessible-role: list;
            accessible-label: @tr("Event list");
            vertical-stretch: 1;
            min-height: 40px;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            // The natural height of the list, not the box: short lists do not scroll, long ones do.
            content-height: events-list.preferred-height;
            events-list := VerticalLayout {
                width: parent.width;
                spacing: 2px;
                alignment: start;
                for event in data.events: Text {
                    text: event;
                    accessible-label: event;
                    color: Theme.ink;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        // Without events nothing else stretches, so this keeps the buttons at the bottom.
        if data.events.length == 0: Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: 8px;
            FocusFrame {
                width: copy-bs-button.width;
                height: copy-bs-button.height;
                focused: copy-bs-button.has-focus;
                copy-bs-button := Button {
                    text: @tr("Copy BS");
                    accessible-label: @tr("Copy BS");
                    clicked => { root.copy-bs(); }
                    changed has-focus => {
                        if (copy-bs-button.has-focus) {
                            root.active-control = "detail copy bs";
                        }
                    }
                }
            }
            FocusFrame {
                width: copy-ad-button.width;
                height: copy-ad-button.height;
                focused: copy-ad-button.has-focus;
                copy-ad-button := Button {
                    text: @tr("Copy AD");
                    accessible-label: @tr("Copy AD");
                    clicked => { root.copy-ad(); }
                    changed has-focus => {
                        if (copy-ad-button.has-focus) {
                            root.active-control = "detail copy ad";
                        }
                    }
                }
            }
        }
    }
}
