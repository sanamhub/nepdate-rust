// The converter (WR-07): an inline card inside the popup, opened from the header. The
// "Convert" tab converts one date; the "Days" tab counts between two BS dates. `app::converter`
// does the work; `ui_bridge::set_converter` fills `data`.

import { FocusFrame } from "focus-frame.slint";
import { Theme } from "theme.slint";
import { Button, LineEdit } from "std-widgets.slint";

export struct ConverterData {
    short: string,
    long: string,
    error: string,
}

export component Converter inherits Rectangle {
    in-out property <ConverterData> data;
    in-out property <string> input: "";
    in-out property <string> from: "";
    in-out property <string> to: "";
    /// 0 = Convert, 1 = Days.
    in-out property <int> tab: 0;
    /// 0 = BS to AD, 1 = AD to BS.
    in-out property <int> direction: 0;

    callback edited(string, int);
    callback days-edited(string, string);
    callback closed();
    callback control-focused(string);

    /// The focused control's stable name.
    out property <string> focused-control: root.active-control;
    /// Set by the control that gains focus inside the converter.
    in-out property <string> active-control: "";
    changed active-control => { root.control-focused(root.active-control); }

    width: 320px;
    height: 300px;
    background: Theme.surface-raised;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.hairline;

    // Swallow clicks on the card so they do not reach the scrim behind it.
    TouchArea {}

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: @tr("Converter");
                color: Theme.ink;
                font-size: 16px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            FocusFrame {
                width: close-button.width;
                height: close-button.height;
                focused: close-button.has-focus;
                close-button := Button {
                    text: @tr("Close");
                    accessible-label: @tr("Close converter");
                    clicked => { root.closed(); }
                    changed has-focus => {
                        if (close-button.has-focus) { root.active-control = "converter close"; }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 4px;
            FocusFrame {
                width: convert-tab.width;
                height: convert-tab.height;
                focused: convert-tab.has-focus;
                convert-tab := Button {
                    text: @tr("Convert");
                    checkable: true;
                    checked: root.tab == 0;
                    accessible-label: @tr("Convert tab");
                    clicked => { root.tab = 0; }
                    changed has-focus => {
                        if (convert-tab.has-focus) { root.active-control = "converter convert tab"; }
                    }
                }
            }
            FocusFrame {
                width: days-tab.width;
                height: days-tab.height;
                focused: days-tab.has-focus;
                days-tab := Button {
                    text: @tr("Days");
                    checkable: true;
                    checked: root.tab == 1;
                    accessible-label: @tr("Days tab");
                    clicked => { root.tab = 1; }
                    changed has-focus => {
                        if (days-tab.has-focus) { root.active-control = "converter days tab"; }
                    }
                }
            }
        }

        if root.tab == 0: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 4px;
                FocusFrame {
                    width: bs-button.width;
                    height: bs-button.height;
                    focused: bs-button.has-focus;
                    bs-button := Button {
                        text: "BS → AD";
                        checkable: true;
                        checked: root.direction == 0;
                        clicked => {
                            root.direction = 0;
                            root.edited(root.input, 0);
                        }
                        changed has-focus => {
                            if (bs-button.has-focus) { root.active-control = "converter bs to ad"; }
                        }
                    }
                }
                FocusFrame {
                    width: ad-button.width;
                    height: ad-button.height;
                    focused: ad-button.has-focus;
                    ad-button := Button {
                        text: "AD → BS";
                        checkable: true;
                        checked: root.direction == 1;
                        clicked => {
                            root.direction = 1;
                            root.edited(root.input, 1);
                        }
                        changed has-focus => {
                            if (ad-button.has-focus) { root.active-control = "converter ad to bs"; }
                        }
                    }
                }
            }
            FocusFrame {
                horizontal-stretch: 1;
                height: input.height;
                focused: input.has-focus;
                input := LineEdit {
                    width: 100%;
                    text <=> root.input;
                    placeholder-text: "2081/01/01 or 2024-04-13";
                    accessible-label: @tr("Date to convert");
                    edited(text) => { root.edited(text, root.direction); }
                    changed has-focus => {
                        if (input.has-focus) { root.active-control = "converter input"; }
                    }
                }
            }
        }

        if root.tab == 1: VerticalLayout {
            spacing: 6px;
            FocusFrame {
                horizontal-stretch: 1;
                height: from-input.height;
                focused: from-input.has-focus;
                from-input := LineEdit {
                    width: 100%;
                    text <=> root.from;
                    placeholder-text: @tr("From BS date");
                    accessible-label: @tr("From BS date");
                    edited(text) => { root.days-edited(text, root.to); }
                    changed has-focus => {
                        if (from-input.has-focus) { root.active-control = "converter from"; }
                    }
                }
            }
            FocusFrame {
                horizontal-stretch: 1;
                height: to-input.height;
                focused: to-input.has-focus;
                to-input := LineEdit {
                    width: 100%;
                    text <=> root.to;
                    placeholder-text: @tr("To BS date");
                    accessible-label: @tr("To BS date");
                    edited(text) => { root.days-edited(root.from, text); }
                    changed has-focus => {
                        if (to-input.has-focus) { root.active-control = "converter to"; }
                    }
                }
            }
        }

        if root.data.error != "": Text {
            text: root.data.error;
            color: Theme.sindoor;
            font-size: 12px;
            wrap: word-wrap;
        }
        if root.data.error == "" && root.data.short != "": Text {
            text: root.data.short;
            color: Theme.ink;
            font-size: 16px;
        }
        if root.data.error == "" && root.data.long != "": Text {
            text: root.data.long;
            color: Theme.ink-muted;
            font-size: 13px;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; }
    }
}
