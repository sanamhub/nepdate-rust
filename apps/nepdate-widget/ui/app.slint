// The main window. Shows today's BS date in both languages, in the bundled fonts.
// font-test.slint is the debug-only Devanagari spike window (W0-03); importing it here keeps a
// single slint_build::compile entry point.
import { FontTestWindow } from "font-test.slint";
export { FontTestWindow }
import "fonts/NotoSans-Variable.ttf";
import "fonts/NotoSansDevanagari-Variable.ttf";

export component AppWindow inherits Window {
    title: "nepdate";
    preferred-width: 360px;
    preferred-height: 160px;
    background: #FDFBF8; // surface, docs/plan/widget-design.md
    default-font-family: "Noto Sans";

    in property <string> bs-en: "";
    in property <string> bs-ne: "";

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        Text {
            text: root.bs-en;
            color: #211C17; // ink
            font-size: 16px;
        }
        Text {
            text: root.bs-ne;
            color: #211C17; // ink
            font-size: 22px;
            font-family: "Noto Sans Devanagari";
        }
    }
}
